{
  "name": "findai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "server": "node backend/index.js",
    "start": "node backend/index.js",
    "dev:all": "concurrently -n \"API,APP\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run dev\"",
    "start:all": "concurrently -n \"API,APP\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run dev\"",
    "build": "npm --prefix frontend run build",
    "start:prod": "npm run build && npm --prefix backend start",
    "test": "npm --prefix backend test",
    "test:server": "npm --prefix backend test",
    "evaluate:ai": "npm --prefix backend run evaluate:ai",
    "lint": "npx oxlint frontend/src",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
