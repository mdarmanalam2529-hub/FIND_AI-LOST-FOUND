{
  "name": "lost-find-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "concurrently -n \"API,APP\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run dev\"",
    "dev:all": "concurrently -n \"API,APP\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run dev\"",
    "start:prod": "npm run build && node server/index.js",
    "test:server": "node server/testClaimWorkflow.js && node server/testSecurityAudit.js && node server/testMetrics.js && node server/testClipMatcher.js && node server/testImageMatchingIntegration.js && node server/testAiMatcher.js",
    "evaluate:ai": "node server/evaluate.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
