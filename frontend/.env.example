# -----------------------------------------------------------------------------
# FindAI Frontend Environment Variables (Vercel Production & Local Development)
# -----------------------------------------------------------------------------

# Supabase Client Configuration (Public variables safely exposed to browser bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Backend API Base URL
# - In local development: Leave blank so requests use Vite dev proxy to http://localhost:3001
# - In Vercel production: Set to your hosted Render backend URL (e.g. https://findai-backend.onrender.com)
VITE_API_URL=https://your-backend-app.onrender.com

# -----------------------------------------------------------------------------
# CRITICAL SECURITY RULES:
# - NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend .env or prefix it with VITE_
# - Vite build will abort immediately if any service-role key is detected in VITE_ variables
# -----------------------------------------------------------------------------

