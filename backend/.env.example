# -----------------------------------------------------------------------------
# FindAI Backend Environment Variables (Render Production & Local Server)
# -----------------------------------------------------------------------------

# Runtime Port & Environment Mode
PORT=3001
NODE_ENV=production

# Supabase Backend Configuration
# Obtain from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Administrative Accounts (Comma-separated verified university emails granted admin privileges)
ADMIN_EMAILS=admin@university.edu,security@university.edu

# Cross-Origin Resource Sharing (CORS) Configuration
# Add your deployed Vercel frontend domain and any custom domain
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# AI Matching Configuration (Optional)
# Set to 'true' if deploying on a 512MB memory tier to disable CLIP vision and run text-only embeddings
DISABLE_CLIP_IMAGE_MATCHER=false

