# -----------------------------------------------------------------------------
# Local Supabase Development Configuration (.env.local)
# Copy this file to .env.local to activate local development mode.
# When .env.local exists, both the Vite frontend and Node server will automatically
# prioritize these settings without modifying or touching your hosted .env file.
# -----------------------------------------------------------------------------

# Local Supabase API Gateway (default port 54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Local Public Anon Key (obtained from `npx supabase status` after `npx supabase start`)
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key-from-supabase-status
VITE_SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-status
SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-status

# Local Server-Only Service Role Key (NEVER expose with VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-from-supabase-status

# Local Environment Settings
PORT=3001
NODE_ENV=development
ADMIN_EMAILS=admin@university.edu
