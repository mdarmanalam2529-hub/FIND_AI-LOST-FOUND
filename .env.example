# -----------------------------------------------------------------------------
# Supabase Configuration (Client-side)
# -----------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
#
# IMPORTANT:
# - Only use your Project URL and Publishable (Anon) Key here.
# - NEVER put your service_role key, secret keys, or database passwords in this file.
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
